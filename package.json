{
  "name": "tool-development",
  "productName": "Tools Development",
  "version": "1.0.0",
  "description": "Desktop workbench for authoring, testing and publishing MCP tools across Linux, WSL, Windows and macOS.",
  "license": "MIT",
  "author": {
    "name": "Tools Development",
    "email": "maintainers@tool-development.dev"
  },
  "homepage": "https://github.com/tool-development/tool-development",
  "repository": {
    "type": "git",
    "url": "https://github.com/tool-development/tool-development.git"
  },
  "bugs": {
    "url": "https://github.com/tool-development/tool-development/issues"
  },
  "main": "./out/main/index.js",
  "bin": {
    "tool-development": "./out/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@uiw/react-codemirror": "^4.25.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.toolstudio.tooldevelopment",
    "productName": "Tools Development",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "out/cli",
        "to": "cli"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "tool-development",
      "icon": "build/icons",
      "synopsis": "Author, test and publish MCP tools",
      "desktop": {
        "entry": {
          "Name": "Tools Development",
          "Comment": "Author, test and publish MCP tools"
        }
      },
      "mimeTypes": [
        "application/json"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
